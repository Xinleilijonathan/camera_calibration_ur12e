# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/

# Collected calibration data is large and machine-specific.
# Keep the directory skeleton (.gitkeep) but not the captures.
data/**/images/*.png
data/**/images/*.jpg
data/**/*.log
# Verification overlays are regenerated by verify_calibration.py and run to
# ~1 MB each -- 120 of them, 109 MB, for three cameras. The numbers that
# matter live in verification_report.yaml, which is small and is kept.
data/**/verification/*.png

# Logs
logs/

# Generated printable board (regenerate with scripts/make_board.py)
apriltag_board.pdf
apriltag_board.png

# Debug frames dropped by preview_apriltag.py --headless
preview_*.png
